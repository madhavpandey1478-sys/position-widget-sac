{
    "id": "com.madhav.positionmanage",
    "version": "2.0.0",
    "name": "Position Manage",
    "description": "Position management and maintenance data entry widget",
    "newInstancePrefix": "PositionManage",
    "vendor": "Madhav Pandey",
    "eula": "",
    "license": "",

    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-positionmanage",
            "url": "https://madhavpandey1478-sys.github.io/position-widget-sac/position.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],

    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },

    "methods": {
        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event generated by the Position Manage widget."
        },

        "getData": {
            "returnType": "string",
            "description": "Returns the Position Manage table data."
        },

        "setData": {
            "description": "Sets the Position Manage table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Serialized Position Manage table data."
                }
            ]
        },

        "setCellValue": {
            "description": "Sets a value in a Position Manage table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Cell value."
                }
            ]
        },

        "setRowOptions": {
            "description": "Sets dropdown options for a Position Manage row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array containing dropdown options."
                }
            ]
        }
    },

    "events": {
        "onFieldChange": {
            "description": "Triggered when a field value is changed in a Position Manage row."
        },

        "onDataEntry": {
            "description": "Triggered when Position Manage data is entered, modified, or selected."
        },

        "onValidate": {
            "description": "Triggered when the user clicks Validate."
        },

        "onClear": {
            "description": "Triggered when the user clears selected Position Manage row data."
        },

        "onSave": {
            "description": "Triggered when Position Manage data is saved."
        },

        "onDelete": {
            "description": "Triggered when selected Position Manage records are deleted."
        }
    }
}
